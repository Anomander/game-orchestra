<div class="game-orchestra-mood-widget-content">
  <div class="mood-active-bar">
    {{#if inCombat}}
      {{#if activePhaseObj}}
      <span class="mood-active-badge" style="background-color: {{activePhaseObj.color}};">
        <i class="{{activePhaseObj.icon}}"></i> {{localize activePhaseObj.label}}
      </span>
      {{else}}
      <span class="mood-active-badge default">
        <i class="fas fa-swords"></i> {{localize "GameOrchestra.Default"}}
      </span>
      {{/if}}
    {{else}}
      {{#if activeMoodObj}}
      <span class="mood-active-badge" style="background-color: {{activeMoodObj.color}};">
        <i class="{{activeMoodObj.icon}}"></i> {{localize activeMoodObj.label}}
      </span>
      {{else}}
      <span class="mood-active-badge default">
        <i class="fas fa-music"></i> {{localize "GameOrchestra.Default"}}
      </span>
      {{/if}}
    {{/if}}
  </div>

  {{! What is actually winning, and any additive layer over it. The same sentence the
      hub shows, from the same builder (transport.mjs) - UX-7: a surface that shows a
      binding shows whether it is the one being heard. }}
  {{#if activeResolution}}
  <div class="mood-widget-resolution" data-tooltip="{{localize 'GameOrchestra.PlaylistTree.ActivePlaying'}}">
    <span class="active-dot">●</span>
    <span class="active-text">{{activeResolution.label}}</span>
  </div>
  {{/if}}
  {{#each layerResolutions}}
  <div class="mood-widget-resolution layer" data-tooltip="{{localize 'GameOrchestra.PlaylistTree.LayerTooltip'}}">
    <span class="active-dot"><i class="fas fa-layer-group"></i></span>
    <span class="active-text">{{this.label}}</span>
  </div>
  {{/each}}

  {{#if inCombat}}
  <div class="mood-widget-axis mood-widget-axis-primary">
    <div class="mood-widget-pills">
      {{#each phases}}
      <button type="button" class="mood-pill {{#if this.isActive}}active{{/if}}" data-action="setPhase" data-phase-id="{{this.id}}" data-tooltip="{{localize this.label}}" style="--mood-color: {{this.color}};">
        <i class="{{this.icon}}"></i>
        <span>{{localize this.label}}</span>
      </button>
      {{/each}}
    </div>
  </div>
  {{else}}
  <div class="mood-widget-axis mood-widget-axis-primary">
    <div class="mood-widget-pills">
      {{#each moods}}
      <button type="button" class="mood-pill {{#if this.isActive}}active{{/if}}" data-action="setMood" data-mood-id="{{this.id}}" data-tooltip="{{localize this.label}}" style="--mood-color: {{this.color}};">
        <i class="{{this.icon}}"></i>
        <span>{{localize this.label}}</span>
      </button>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{! Suppression lives here as well as on the scene-control bar, because this is the
      surface that is actually open during play (UX-6). Both render the same
      transport.mjs descriptors and dispatch the same action - never a second copy of
      the behaviour (UX-2). }}
  <div class="mood-widget-suppression">
    {{#each suppression}}
    <button type="button" class="suppression-toggle {{#if this.active}}active{{/if}}"
            data-action="toggleSuppression" data-setting="{{this.setting}}"
            data-tooltip="{{this.title}}" aria-pressed="{{this.active}}">
      <i class="{{this.icon}}"></i>
    </button>
    {{/each}}
  </div>
</div>
