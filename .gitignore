game-orchestra.lock
README.html
node_modules/
package-lock.json
coverage/

# Release build output (`npm run build`). Generated on every release from the tree; never a
# source of truth, and never committed - a stale dist/ that disagreed with scripts/ would be
# indistinguishable from a working one until a user loaded it.
dist/

.claude/

# Integration tier: generated tone fixtures and Playwright output. The fixtures are rendered from
# itest/harness/tones.mjs on demand - committing binary audio would let a fixture's frequency
# drift out of sync with the detector that identifies it.
itest/fixtures/out/
itest/report/
itest/test-results/

# Cached Foundry release archive (licensed software - never commit).
itest/.cache/
